# Frontend env (Vercel / local)
# Public API base URL used by browser code
VITE_API_URL=http://localhost:3001/api

# Socket.io endpoint (same host as backend)
VITE_SOCKET_URL=http://localhost:3001

# Yjs websocket endpoint (use wss:// in production)
PUBLIC_WS_URL=ws://localhost:3001

# Optional: used by server-side SvelteKit load functions
API_URL=http://localhost:3001/api