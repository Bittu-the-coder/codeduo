# Server env (GCP Cloud Run / local)
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Client URLs
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
ALLOW_VERCEL_PREVIEW_ORIGINS=false
BACKEND_URL=http://localhost:3001

# Data stores
MONGODB_URI=mongodb://localhost:27017/codeduo
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override. Default is ${BACKEND_URL}/api/auth/github/callback
GITHUB_CALLBACK_URL=

# Features
ENABLE_RATE_LIMITING=true
LOG_TO_FILE=false
